// Secrets.example.xcconfig
// Plantilla de credenciales de IGDB (equivalente a un .env en proyectos de Xcode).
//
// 1. Copia este archivo como Config/Secrets.xcconfig
// 2. Crea una aplicación en https://dev.twitch.tv/console/apps
//    (IGDB usa las credenciales de Twitch) y pega aquí su Client ID y Client Secret.
// 3. Compila de nuevo. La app pide y renueva el token de acceso automáticamente.
//
// Sin comillas y sin espacios al final. Secrets.xcconfig está en .gitignore: no lo subas.

IGDB_CLIENT_ID = tu_client_id_de_twitch
IGDB_CLIENT_SECRET = tu_client_secret_de_twitch
